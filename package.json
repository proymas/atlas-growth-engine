{
  "name": "atlas-growth-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Independent growth automation infrastructure for Atlas.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "browser:install": "playwright install chromium",
    "smoke:reddit": "tsx src/smoke/reddit.ts",
    "smoke:reddit-oauth": "tsx src/reddit/read-smoke.ts",
    "reddit:login": "tsx src/reddit/login.ts",
    "smoke:reddit-auth": "tsx src/reddit/auth-smoke.ts",
    "smoke:x-env": "node --env-file=.env --import tsx src/x/auth-smoke.ts",
    "smoke:x-write": "node --env-file=.env --import tsx src/x/write-smoke.ts",
    "x:login": "tsx src/x/browser-login.ts",
    "smoke:x-browser-auth": "tsx src/x/browser-auth-smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
